# Arm coordinates and pick-and-place sequences per mode.
# THESE ARE PLACEHOLDERS. Tomorrow, jog the real arm to each real position
# and replace these numbers — don't trust these values, they're just here
# so the pipeline runs end-to-end tonight in simulation.
#
# Units follow whatever pydobot/the Dobot API returns for your arm (mm for
# x/y/z, degrees for r) — jogging and reading back the position tomorrow
# will show you the actual numbers to use.

# SAFETY: dobot_node refuses simulate:=false until this is true. Flip it only
# after every x/y/z below has been measured on the real arm.
calibrated: true

# The arm's hardware home, read after homing (x=265.6, y=-3.6, z=-4.3). `home`
# below is only used when the node needs a travel point; keep it above the table.
home: {x: 174.4, y: 237.5, z: 52.5, r: 0}   # above the measured pickup spot (block top z=12.5 + 40 mm hover)

bins:
  red_block:   {x: 150, y: 150, z: 0, r: 0}
  blue_block:  {x: 150, y: -150, z: 0, r: 0}
  rubiks_cube: {x: 200, y: 150, z: 0, r: 0}

pickup:
  # Each item sits at its own marked spot so all required items can be in
  # view of the camera at once. Items without an entry use `default`.
  # x/y measured from the arm (hovering above the spot); z is a PLACEHOLDER —
  # lower the cup until it touches the block and read the real z.
  default:     {x: 278.0, y: 94.8, z: 12.3, r: 0}
  red_block:   {x: 278.0, y: 94.8, z: 12.3, r: 0}   # shared pickup spot, measured
  blue_block:  {x: 278.0, y: 94.8, z: 12.3, r: 0}   # shared pickup spot, measured
  rubiks_cube: {x: 276.1, y: 94.5, z: 63.8, r: 0}   # shared pickup spot; z = cube top, measured (cube ~51.5 mm tall)

# Where each item goes, per mode, in the order they are placed.
place:
  mode_1:                       # red to the left, blue to the right
    - {item: red_block,  x: 122.2, y: 258.7, z: 24.3, r: 0}   # left side, measured (z = right-side level)
    - {item: blue_block, x: 207.1, y: -193.6, z: 24.3, r: 0}   # right side, measured
  mode_2:                       # red block stacked on the Rubik's cube
    - {item: rubiks_cube, x: 231.2, y: -204.8, z: 66.8, r: 0}   # x/y measured; z = cube-top contact at pickup (63.8) + 3 mm clearance
    - {item: red_block,   x: 231.2, y: -204.8, z: 91.8, r: 0}   # on top of cube: 63.8 cube top + 25 block height + 3 mm clearance

# Sequence for one item: move above pickup, descend, suck on, lift, move
# above bin, descend, suck off, lift, return home. This is used as a
# *template* — the real node fills in the actual x/y/z per item at runtime.
hover_height_offset: 40
